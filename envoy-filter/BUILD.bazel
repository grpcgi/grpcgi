load(
    "//bazel:envoy_build_system.bzl",
    "envoy_cc_extension",
    "envoy_cc_library",
    "envoy_extension_package",
    "envoy_proto_library",
)

licenses(["notice"])  # Apache 2

envoy_extension_package()

# ---------------------------------------------------------------------------
# Proto for the filter's typed xDS configuration.
# ---------------------------------------------------------------------------
envoy_proto_library(
    name = "config_proto",
    srcs = ["proto/envoy/extensions/filters/http/grpc_websocket_bridge/v3/config.proto"],
    deps = [
        "@com_envoyproxy_protoc_gen_validate//validate:validate_proto",
        "@com_github_cncf_xds//udpa/annotations:pkg",
    ],
)

# ---------------------------------------------------------------------------
# The filter implementation library.
# ---------------------------------------------------------------------------
envoy_cc_library(
    name = "ws_grpc_bridge_filter_lib",
    srcs = ["ws_grpc_bridge_filter.cc"],
    hdrs = ["ws_grpc_bridge_filter.h"],
    deps = [
        ":config_proto_cc_proto",
        "//envoy/grpc:async_client_interface",
        "//envoy/grpc:async_client_manager_interface",
        "//envoy/http:codes_interface",
        "//envoy/http:filter_interface",
        "//source/common/buffer:buffer_lib",
        "//source/common/common:assert_lib",
        "//source/common/common:minimal_logger_lib",
        "//source/common/grpc:common_lib",
        "//source/common/grpc:typed_async_client_lib",
        "//source/common/http:header_map_lib",
        "//source/common/http:headers_lib",
        # grpcgi proto — bring in from the grpcgi proto library target.
        "//third_party/grpcgi:websocket_cc_proto",
    ],
)

# ---------------------------------------------------------------------------
# Factory registration — this is what Envoy loads into its filter registry.
# ---------------------------------------------------------------------------
envoy_cc_extension(
    name = "config",
    srcs = ["config.cc"],
    hdrs = ["config.h"],
    # Extra build tag so `//tools:check_extensions_build_config` is satisfied.
    extra_tags = ["manual"],
    deps = [
        ":ws_grpc_bridge_filter_lib",
        "//envoy/registry",
        "//envoy/server:filter_config_interface",
        "//source/common/common:assert_lib",
        "//source/extensions/filters/http/common:pass_through_filter_lib",
    ],
)
